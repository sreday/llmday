---
import type { ScheduleData } from '../../lib/schedule';
import { getSpeakers } from '../../lib/schedule';
import SpeakerCard from '../cards/SpeakerCard.astro';

interface Props {
  schedule: ScheduleData;
  eventSlug: string;
}

const { schedule, eventSlug } = Astro.props;
const speakers = getSpeakers(schedule);
---

<section id="speakers" class="speakers-section section">
  <div class="container">
    <h3 class="section-heading text-center mb-5">Speakers</h3>
    <div class="row">
      {speakers.map((speaker) => (
        <div class="col-6 col-md-4 col-lg-3">
          <SpeakerCard talk={speaker} eventSlug={eventSlug} />
        </div>
      ))}
    </div>
  </div>
</section>
