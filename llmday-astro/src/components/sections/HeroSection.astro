---
import type { Event } from '../../content.config';

interface Props {
  event: Event;
}

const { event } = Astro.props;
---

<div id="home" class="hero-block">
  <div
    class="hero-background tinted"
    style={`background-image: url('${event.heroPictures[0] || ''}');`}
  />

  <div class="container">
    <div class="hero-text-block text-center" style="max-width: 100%;">
      <h1 class="logo retro">LLMDAY</h1>
      <h2 class="hero-subtitle">Large Language Models, AI and ML</h2>
      <p class="hero-tagline">In-person conferences</p>
      <h3 class="text-white hero-info">
        <span class="info-item">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          {event.dateString}
        </span>
        <span class="info-item">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {event.locationString}
        </span>
      </h3>

      <!-- Social Icons -->
      <div class="hero-social">
        {event.linkedinUrl && (
          <a href={event.linkedinUrl} target="_blank" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        )}
        {event.youtubeUrl && (
          <a href={event.youtubeUrl} target="_blank" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        )}
        {event.twitterUrl && (
          <a href={event.twitterUrl} target="_blank" aria-label="Twitter">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
          </a>
        )}
      </div>

      <div class="hero-divider"></div>

      <div class="hero-cta">
        <a class="btn btn-secondary btn-lg" href="#tickets">Get Tickets</a>
        {event.state !== 'after' && event.cfpUrl && (
          <a class="btn btn-primary btn-lg" href={event.cfpUrl} target="_blank">CFP</a>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .hero-block {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center;
  }

  .hero-background.tinted::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .hero-text-block {
    position: relative;
    z-index: 1;
    padding: 2rem;
  }

  .hero-subtitle {
    color: white;
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .hero-tagline {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .hero-info {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
    align-items: center;
    font-size: 1.25rem;
    font-weight: 400;
    margin-bottom: 1.5rem;
  }

  .info-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon {
    width: 1.25em;
    height: 1.25em;
    vertical-align: middle;
  }

  .hero-social {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .hero-social a {
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
  }

  .hero-social a:hover {
    opacity: 0.8;
  }

  .hero-social svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .hero-divider {
    width: 60px;
    height: 2px;
    background: rgba(255, 255, 255, 0.5);
    margin: 1.5rem auto;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .hero-info {
      flex-direction: column;
      gap: 0.75rem;
    }

    .hero-subtitle {
      font-size: 1.25rem;
    }
  }
</style>
