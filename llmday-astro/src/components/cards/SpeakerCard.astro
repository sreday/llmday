---
import { Image } from 'astro:assets';
import type { ScheduleTalk } from '../../lib/schedule';

interface Props {
  talk: ScheduleTalk;
  eventSlug: string;
}

const { talk, eventSlug } = Astro.props;
const speaker = talk.data.speaker;
const talkUrl = `/${eventSlug}/talks/${talk.slug}`;

// Dynamic import for speaker photo
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/speakers/*.png', { eager: true });
const imagePath = `/src/assets/speakers/${speaker.photo}`;
const speakerImage = images[imagePath]?.default;
---

<div class="speaker-card">
  <a href={talkUrl}>
    {speakerImage ? (
      <Image
        src={speakerImage}
        alt={speaker.name}
        width={150}
        height={150}
        class="profile-image"
      />
    ) : (
      <img
        class="profile-image"
        src={`/speakers/${speaker.photo}`}
        alt={speaker.name}
      />
    )}
  </a>
  <h5>{speaker.name}</h5>
  <div class="meta">{speaker.organization}</div>
  <a href={talkUrl} class="read-more">Read more &rarr;</a>
  <ul class="social-list">
    {speaker.twitter && (
      <li>
        <a href={`https://twitter.com/${speaker.twitter}`} target="_blank" rel="noopener">
          <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </li>
    )}
    {speaker.linkedin && (
      <li>
        <a href={speaker.linkedin} target="_blank" rel="noopener">
          <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </li>
    )}
  </ul>
</div>

<style>
  .speaker-card {
    text-align: center;
    margin-bottom: 2rem;
  }

  .profile-image {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 1rem;
    transition: transform 0.2s ease;
  }

  .profile-image:hover {
    transform: scale(1.05);
  }

  h5 {
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .read-more {
    font-size: 0.875rem;
    color: var(--color-primary);
    text-decoration: none;
  }

  .read-more:hover {
    text-decoration: underline;
  }

  .social-list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }

  .social-list a {
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .social-list a:hover {
    color: var(--color-primary);
  }

  .icon {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
