---
import { Image } from 'astro:assets';
import type { ScheduleData } from '../../lib/schedule';
import { truncate } from '../../lib/utils';

interface Props {
  schedule: ScheduleData;
  eventSlug: string;
}

const { schedule, eventSlug } = Astro.props;

// Preload all speaker images
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/speakers/*.png', { eager: true });

function getSpeakerImage(photo: string) {
  const imagePath = `/src/assets/speakers/${photo}`;
  return images[imagePath]?.default;
}
---

{schedule.tracks.map((track, trackIndex) => (
  <div>
    <div class="track-section-header" id={`track-${trackIndex + 1}`}>
      {track.roomName} &bull; Track {track.trackId}
    </div>

    {track.items.map((item) => {
      if (item.type === 'break' || item.type === 'wrapup') {
        return (
          <div class="schedule-item break-item">
            <div class="meta">
              <h4 class="time">{item.timeStr}</h4>
            </div>
            <div class="content">
              <h3>{item.breakInfo?.title}</h3>
              {item.breakInfo?.comment && (
                <div class="location">{item.breakInfo.comment}</div>
              )}
            </div>
          </div>
        );
      }

      if (item.talk) {
        const talk = item.talk;
        const talkUrl = `/${eventSlug}/talks/${talk.slug}`;
        const speakerImage = getSpeakerImage(talk.data.speaker.photo);
        return (
          <div class="schedule-item">
            <div class="meta">
              <h4 class="time">{item.timeStr}</h4>
              <a href={talkUrl}>
                {speakerImage ? (
                  <Image
                    src={speakerImage}
                    alt={talk.data.speaker.name}
                    width={80}
                    height={80}
                    class="profile-image"
                  />
                ) : (
                  <div class="profile-placeholder" />
                )}
              </a>
              <div class="name">{talk.data.speaker.name}</div>
            </div>
            <div class="content">
              <h3>
                <a href={talkUrl}>{talk.data.title}</a>
              </h3>
              <div class="location">{talk.data.speaker.organization}</div>
            </div>
          </div>
        );
      }

      return null;
    })}
  </div>
))}

<style>
  .profile-placeholder {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #e5e7eb;
  }
</style>
