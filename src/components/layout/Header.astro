---
import type { Event } from '../../content.config';

interface Props {
  event?: Event;
}

const { event } = Astro.props;
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/60">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <div class="flex items-center">
        <a href="/" class="flex items-center gap-2">
          <span class="text-xl font-bold tracking-tight text-slate-900">LLM<span class="text-primary-600">day</span></span>
        </a>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex md:gap-x-8">
        {event ? (
          <>
            <a href="/" class="text-sm font-semibold leading-6 text-slate-900 hover:text-primary-600">Home</a>
            <a href="#schedule" class="text-sm font-semibold leading-6 text-slate-900 hover:text-primary-600">Schedule</a>
            <a href="#speakers" class="text-sm font-semibold leading-6 text-slate-900 hover:text-primary-600">Speakers</a>
            <a href="#venue" class="text-sm font-semibold leading-6 text-slate-900 hover:text-primary-600">Venue</a>
            <a href="#sponsors" class="text-sm font-semibold leading-6 text-slate-900 hover:text-primary-600">Sponsors</a>
          </>
        ) : (
          <>
            <a href="#upcoming" class="text-sm font-semibold leading-6 text-slate-900 hover:text-primary-600">Events</a>
            <a href="#past" class="text-sm font-semibold leading-6 text-slate-900 hover:text-primary-600">Past</a>
            <a href="#testimonials" class="text-sm font-semibold leading-6 text-slate-900 hover:text-primary-600">Testimonials</a>
            <a href="#sponsor" class="text-sm font-semibold leading-6 text-slate-900 hover:text-primary-600">Sponsor</a>
          </>
        )}
      </nav>

      <!-- CTA Button -->
      <div class="hidden md:flex md:items-center">
        {event ? (
             event.lumaEventId ? (
                <a href="#tickets" class="rounded-full bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
                  Get Tickets
                </a>
             ) : (
                <span class="text-sm text-slate-500">Registration Closed</span>
             )
        ) : (
          <a href="#upcoming" class="rounded-full bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
            Find an Event
          </a>
        )}
      </div>

      <!-- Mobile menu button (simple implementation for now) -->
      <div class="flex md:hidden">
        <button type="button" class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-slate-700">
          <span class="sr-only">Open main menu</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
