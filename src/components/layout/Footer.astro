---
import type { Event } from '../../content.config';

interface Props {
  event?: Event;
}

const { event } = Astro.props;
const mailto = event?.mailto || 'mailto:hello@llmday.com';
const linkedinUrl = event?.linkedinUrl || 'https://www.linkedin.com/company/llmday/';
const twitterUrl = event?.twitterUrl || 'https://twitter.com/llmday_com';
const youtubeUrl = event?.youtubeUrl || 'https://www.youtube.com/@llmday';
---

<footer class="bg-slate-900" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8 lg:pt-32">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-8">
        <span class="text-2xl font-bold tracking-tight text-white">LLM<span class="text-primary-400">day</span></span>
        <p class="text-sm leading-6 text-slate-300">
          The premier conference series for Large Language Models, AI, and Machine Learning. Connecting experts worldwide.
        </p>
        <div class="flex space-x-6">
          <a href={twitterUrl} class="text-slate-400 hover:text-white">
            <span class="sr-only">Twitter</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
            </svg>
          </a>
          <a href={linkedinUrl} class="text-slate-400 hover:text-white">
            <span class="sr-only">LinkedIn</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />
            </svg>
          </a>
          <a href={youtubeUrl} class="text-slate-400 hover:text-white">
            <span class="sr-only">YouTube</span>
             <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93 5.02 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-semibold leading-6 text-white">Events</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="/#upcoming" class="text-sm leading-6 text-slate-300 hover:text-white">Upcoming</a>
              </li>
              <li>
                <a href="/#past" class="text-sm leading-6 text-slate-300 hover:text-white">Past Events</a>
              </li>
              <li>
                <a href="/#testimonials" class="text-sm leading-6 text-slate-300 hover:text-white">Testimonials</a>
              </li>
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-semibold leading-6 text-white">Participate</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="/#sponsor" class="text-sm leading-6 text-slate-300 hover:text-white">Sponsor</a>
              </li>
              <li>
                <a href="mailto:hello@llmday.com" class="text-sm leading-6 text-slate-300 hover:text-white">Contact Us</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="md:grid md:grid-cols-2 md:gap-8">
           <!-- Placeholder for additional columns if needed -->
        </div>
      </div>
    </div>
    <div class="mt-16 border-t border-white/10 pt-8 sm:mt-20 lg:mt-24">
      <p class="text-xs leading-5 text-slate-400">&copy; {new Date().getFullYear()} LLMday. All rights reserved.</p>
    </div>
  </div>
</footer>
