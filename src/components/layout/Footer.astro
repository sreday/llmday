---
import type { Event } from '../../content.config';

interface Props {
  event?: Event;
}

const { event } = Astro.props;
const mailto = event?.mailto || 'mailto:hello@llmday.com';
const linkedinUrl = event?.linkedinUrl || 'https://www.linkedin.com/company/llmday/';
const twitterUrl = event?.twitterUrl || 'https://twitter.com/llmday_com';
const youtubeUrl = event?.youtubeUrl || 'https://www.youtube.com/@llmday';
---

<footer>
  <p>Contact: <a href={mailto}>hello@llmday.com</a></p>
  <p>
    <a href={linkedinUrl}>LinkedIn</a> |
    <a href={twitterUrl}>Twitter</a> |
    <a href={youtubeUrl}>YouTube</a>
  </p>
</footer>
