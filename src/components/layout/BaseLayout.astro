---
import type { Event } from '../../content.config';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description?: string;
  event?: Event;
}

const { title, description = 'Conference on Large Language Models, AI and ML', event } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{title}</title>
  <meta name="description" content={description}>
</head>

<body>
  <Header event={event} />

  <main>
    <slot />
  </main>

  <Footer event={event} />
</body>
</html>
