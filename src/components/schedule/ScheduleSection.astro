---
import type { Event } from '../../content.config';
import type { ScheduleData } from '../../lib/schedule';
import TableView from './TableView.astro';

interface Props {
  event: Event;
  schedule: ScheduleData;
  eventSlug: string;
}

const { event, schedule, eventSlug } = Astro.props;
---

<section id="schedule">
  <h2>Schedule</h2>
  <p>{event.dateString} - {schedule.tracks.length} parallel tracks</p>
  <p>Rooms: {schedule.tracks.map(t => t.roomName).join(', ')}</p>

  <TableView schedule={schedule} eventSlug={eventSlug} />

  <p><a href="#tickets">Buy Tickets</a></p>
</section>
