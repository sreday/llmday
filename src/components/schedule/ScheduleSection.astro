---
import type { ScheduleData, ScheduleItem } from '../../lib/schedule';

interface Props {
  schedule: ScheduleData;
  eventSlug: string;
}

const { schedule, eventSlug } = Astro.props;

// Helper to group items by time for the view
const timeSlots = schedule.allTimes.map(time => {
  const items: { trackId: string, item: ScheduleItem }[] = [];
  schedule.tracks.forEach(track => {
    const trackItems = track.items.filter(i => i.timeStr === time);
    trackItems.forEach(item => items.push({ trackId: track.trackId, item }));
  });
  return { time, items };
});
---

<div class="flow-root">
  <ul role="list" class="-mb-4">
    {timeSlots.map((slot, slotIdx) => (
      <li>
        <div class="relative pb-4">
          {slotIdx !== timeSlots.length - 1 ? (
            <span class="absolute left-4 top-4 -ml-px h-full w-0.5 bg-slate-100" aria-hidden="true"></span>
          ) : null}
          <div class="relative flex gap-x-4">
            
            {/* Time Column (More compact) */}
            <div class="flex flex-col items-center pt-1">
                 <div class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-50 ring-1 ring-slate-200">
                    <div class="h-2 w-2 rounded-full bg-slate-300"></div>
                 </div>
                 <div class="mt-1 w-12 text-center text-xs font-bold text-slate-500 leading-none">
                    {slot.time}
                 </div>
            </div>

            {/* Content Column */}
            <div class="flex-auto">
                {slot.items.map(({ item }) => {
                    if (item.type === 'break') {
                        return (
                            <div class="rounded bg-slate-50/50 px-3 py-2 ring-1 ring-slate-900/5 mb-2 last:mb-0">
                                <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">{item.breakInfo?.title}</p>
                            </div>
                        );
                    }
                    if (item.talk) {
                         const speaker = item.talk.data.speakers[0];
                         return (
                            <div class="group relative rounded-lg border border-slate-200 bg-white p-3 hover:border-primary-300 hover:shadow-sm transition-all mb-2 last:mb-0">
                                <div class="flex justify-between items-start gap-3">
                                    <div class="flex-1 min-w-0">
                                         <h3 class="text-sm font-semibold text-slate-900 leading-tight">
                                            <a href={`/${eventSlug}/talks/${item.talk.slug}/`}>
                                                <span class="absolute inset-0"></span>
                                                {item.talk.data.title}
                                            </a>
                                        </h3>
                                        <p class="mt-1 text-xs text-slate-500 truncate">
                                            {speaker.name}
                                            {speaker.organization && <span class="text-slate-400"> • {speaker.organization}</span>}
                                        </p>
                                    </div>
                                    <div class="flex-shrink-0">
                                        {/* Optional: Track indicator or type icon could go here, kept minimal for now */}
                                    </div>
                                </div>
                            </div>
                         );
                    }
                    return null;
                })}
            </div>
          </div>
        </div>
      </li>
    ))}
  </ul>
</div>
