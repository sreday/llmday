---
import type { ScheduleData } from '../../lib/schedule';

interface Props {
  schedule: ScheduleData;
  eventSlug: string;
}

const { schedule, eventSlug } = Astro.props;
---

{schedule.tracks.map((track, trackIndex) => (
  <div id={`track-${trackIndex + 1}`}>
    <h3>{track.roomName} (Track {track.trackId})</h3>
    <ul>
      {track.items.map((item) => {
        if (item.type === 'break' || item.type === 'wrapup') {
          return (
            <li>
              {item.timeStr} - {item.breakInfo?.title}
              {item.breakInfo?.comment && ` (${item.breakInfo.comment})`}
            </li>
          );
        }
        if (item.talk) {
          const speaker = item.talk.data.speakers[0];
          return (
            <li>
              {item.timeStr} -
              <a href={`/${eventSlug}/talks/${item.talk.slug}/`}>{item.talk.data.title}</a>
              by {speaker.name} ({speaker.organization})
            </li>
          );
        }
        return null;
      })}
    </ul>
  </div>
))}
