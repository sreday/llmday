---
import type { ScheduleData, ScheduleItem } from '../../lib/schedule';

interface Props {
  schedule: ScheduleData;
  eventSlug: string;
}

const { schedule, eventSlug } = Astro.props;

// Build a map of time -> track -> items
const timeSlotMap = new Map<string, Map<string, ScheduleItem[]>>();

for (const track of schedule.tracks) {
  for (const item of track.items) {
    if (!timeSlotMap.has(item.timeStr)) {
      timeSlotMap.set(item.timeStr, new Map());
    }
    const trackMap = timeSlotMap.get(item.timeStr)!;
    if (!trackMap.has(track.trackId)) {
      trackMap.set(track.trackId, []);
    }
    trackMap.get(track.trackId)!.push(item);
  }
}
---

<table class="schedule-grid-table">
  <thead>
    <tr>
      <th>Time</th>
      {schedule.tracks.map((track) => (
        <th>{track.roomName}</th>
      ))}
    </tr>
  </thead>
  <tbody>
    {schedule.allTimes.map((time) => (
      <tr>
        <td class="time-cell">{time}</td>
        {schedule.tracks.map((track) => {
          const items = timeSlotMap.get(time)?.get(track.trackId) || [];
          return (
            <td class="talk-cell">
              {items.map((item) => {
                if (item.type === 'break' || item.type === 'wrapup') {
                  return (
                    <div class="break-cell">
                      <strong>{item.breakInfo?.title}</strong>
                      {item.breakInfo?.comment && (
                        <div class="speaker-info">{item.breakInfo.comment}</div>
                      )}
                    </div>
                  );
                }
                if (item.talk) {
                  const talkUrl = `${eventSlug}/talks/${item.talk.slug}`;
                  const speaker = item.talk.data.speakers[0];
                  return (
                    <div>
                      <a href={talkUrl}>{item.talk.data.title}</a>
                      <div class="speaker-info">
                        {speaker.name} &bull; {speaker.organization}
                      </div>
                    </div>
                  );
                }
                return null;
              })}
            </td>
          );
        })}
      </tr>
    ))}
  </tbody>
</table>
