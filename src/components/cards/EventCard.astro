---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  location: string;
  date: string;
  photo?: ImageMetadata;
  url: string;
}

const { name, location, date, photo, url } = Astro.props;
---

<div class="event-card">
  <a href={url} class="image-link">
    {photo && <Image src={photo} alt={name} width={400} height={225} />}
  </a>
  <div class="content">
    <h5>{name}</h5>
    <p class="details">
      <span>{date}</span>
      <span>{location}</span>
    </p>
    <a href={url} class="cta">Learn more</a>
  </div>
</div>

<style>
  .event-card {
    background: white;
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .event-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  .image-link {
    display: block;
    overflow: hidden;
  }

  img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .event-card:hover img {
    transform: scale(1.05);
  }

  .content {
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  h5 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .details {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 1rem;
    flex: 1;
  }

  .details span {
    display: block;
  }

  .cta {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--color-primary);
    color: white;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 0.375rem;
    text-decoration: none;
    transition: background 0.2s ease;
    align-self: flex-start;
  }

  .cta:hover {
    background: var(--color-primary-dark, #1e7a55);
  }
</style>
