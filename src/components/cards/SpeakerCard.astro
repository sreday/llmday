---
import { Image } from 'astro:assets';
import type { ScheduleTalk } from '../../lib/schedule';

interface Props {
  talk: ScheduleTalk;
  eventSlug: string;
}

const { talk, eventSlug } = Astro.props;
const speaker = talk.data.speakers[0];
const talkUrl = `/${eventSlug}/talks/${talk.slug}`;

// Dynamic import for speaker photo
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/speakers/*.png', { eager: true });
const imagePath = `/src/assets/speakers/${speaker.photo}`;
const speakerImage = images[imagePath]?.default;
---

<div class="speaker-card">
  <a href={talkUrl} class="image-link">
    {speakerImage ? (
      <Image
        src={speakerImage}
        alt={speaker.name}
        width={300}
        height={300}
        class="profile-image"
        loading="eager"
      />
    ) : (
      <div class="profile-placeholder" />
    )}
  </a>
  <div class="card-body">
    <h5>{speaker.name}</h5>
    <div class="meta">{speaker.organization}</div>
    <a href={talkUrl} class="read-more">Read more &rarr;</a>
  </div>
  <div class="card-footer">
    <ul class="social-list">
      {speaker.twitter && (
        <li>
          <a href={`https://twitter.com/${speaker.twitter}`} target="_blank" rel="noopener" aria-label="Twitter">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
          </a>
        </li>
      )}
      {speaker.linkedin && (
        <li>
          <a href={speaker.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </li>
      )}
    </ul>
  </div>
</div>

<style>
  .speaker-card {
    text-align: left;
    margin-bottom: 1rem;
    background: #f0f6fa;
    border-radius: 0.5rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .image-link {
    display: block;
  }

  .profile-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  .profile-placeholder {
    width: 100%;
    aspect-ratio: 1;
    background: #e5e7eb;
  }

  .card-body {
    padding: 1rem 1.25rem;
    flex: 1;
  }

  h5 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .meta {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .read-more {
    font-size: 0.875rem;
    color: #3B99A1;
    text-decoration: none;
  }

  .read-more:hover {
    text-decoration: underline;
  }

  .card-footer {
    background: rgba(0, 0, 0, 0.03);
    padding: 0.75rem 1.25rem;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }

  .social-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 0.75rem;
  }

  .social-list a {
    color: #3B99A1;
    transition: color 0.2s ease;
  }

  .social-list a:hover {
    color: #2d7a80;
  }

  .icon {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
