---
import type { ScheduleTalk } from '../../lib/schedule';

interface Props {
  talk: ScheduleTalk;
  eventSlug: string;
}

const { talk, eventSlug } = Astro.props;
const speaker = talk.data.speakers[0];
const talkUrl = `/${eventSlug}/talks/${talk.slug}`;
---

<div>
  <p>
    <a href={talkUrl}>{speaker.name}</a>
    {speaker.organization && ` (${speaker.organization})`}
  </p>
  <p>{talk.data.title}</p>
  {speaker.twitter && <p>Twitter: <a href={`https://twitter.com/${speaker.twitter}`}>@{speaker.twitter}</a></p>}
  {speaker.linkedin && <p><a href={speaker.linkedin}>LinkedIn</a></p>}
</div>
