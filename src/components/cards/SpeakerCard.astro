---
interface Props {
  name: string;
  role?: string;
  company?: string;
  image?: string; // In real app, this would be an ImageMetadata or path
  talkTitle?: string;
  talkSlug?: string;
  eventSlug: string;
}

const { name, role, company, image, talkTitle, talkSlug, eventSlug } = Astro.props;

// Placeholder image if none provided
const imageUrl = image ? `/assets/speakers/${image}` : `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=random`;
---

<a href={`/${eventSlug}/talks/${talkSlug}/`} class="group block">
  <div class="relative w-full overflow-hidden rounded-lg bg-slate-100 aspect-square mb-2">
    <img
        src={imageUrl}
        alt={name}
        class="absolute inset-0 h-full w-full object-cover transition duration-200 group-hover:scale-105"
        loading="lazy"
    />
  </div>
  <div>
    <h3 class="text-xs font-medium text-slate-900 group-hover:text-primary-600 leading-tight truncate">
      {name}
    </h3>
    {company && (
      <p class="text-[10px] text-slate-500 truncate mt-0.5">{company}</p>
    )}
  </div>
</a>
