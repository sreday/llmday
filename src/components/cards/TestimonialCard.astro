---
import type { Testimonial } from '../../content.config';

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<blockquote>
  <p>{testimonial.text}</p>
  <p>— {testimonial.name}
    {testimonial.job && `, ${testimonial.job}`}
    {testimonial.company && ` at ${testimonial.company}`}
  </p>
</blockquote>
