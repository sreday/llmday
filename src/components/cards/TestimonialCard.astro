---
import { Image } from 'astro:assets';
import type { Testimonial } from '../../content.config';

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;

// Import speaker photos for testimonials
const speakerImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/speakers/*.png', { eager: true });

function getHeadshot(filename: string) {
  const path = `/src/assets/speakers/${filename}`;
  return speakerImages[path]?.default;
}

const headshot = testimonial.headshot ? getHeadshot(testimonial.headshot) : null;
---

<div class="testimonial-card">
  <div class="card-image">
    {headshot ? (
      <Image
        src={headshot}
        alt={testimonial.name}
        width={200}
        height={200}
        class="headshot"
      />
    ) : (
      <div class="headshot-placeholder" />
    )}
  </div>
  <div class="card-body">
    <h5 class="author-name">{testimonial.name}</h5>
    <div class="author-meta">
      {testimonial.job && (
        <span class="author-role">{testimonial.job}</span>
      )}
      {testimonial.company && (
        <strong class="author-company">{testimonial.company}</strong>
      )}
    </div>
    <p class="testimonial-text">
      {testimonial.text}
    </p>
  </div>
</div>

<style>
  .testimonial-card {
    background: #f0f6fa;
    border-radius: 0.5rem;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .card-image {
    text-align: center;
    padding-top: 1.5rem;
  }

  .headshot {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #f0f6fa;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .headshot-placeholder {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: #e5e7eb;
    margin: 0 auto;
  }

  .card-body {
    padding: 1rem 1.5rem 1.5rem;
    text-align: center;
  }

  .author-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .author-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }

  .author-role {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .author-company {
    font-size: 0.9rem;
    color: var(--color-primary);
  }

  .testimonial-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #444;
    margin: 0;
  }
</style>
