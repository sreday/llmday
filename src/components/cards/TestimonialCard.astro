---
interface Props {
  name: string;
  role?: string;
  company?: string;
  quote: string;
  headshot?: string;
}

const { name, role, company, quote, headshot } = Astro.props;
---

<figure class="rounded-xl bg-white p-5 text-sm leading-relaxed ring-1 ring-slate-900/5">
  <blockquote class="text-slate-700 text-sm">
    <p>"{quote}"</p>
  </blockquote>
  <figcaption class="mt-3 flex items-center gap-x-3 border-t border-slate-100 pt-3">
    {headshot && (
      <img
        src={`/assets/speakers/${headshot}`}
        alt={name}
        class="size-10 rounded-full object-cover ring-1 ring-slate-200"
      />
    )}
    <div>
      <div class="text-sm font-medium text-slate-900">{name}</div>
      {(role || company) && (
        <div class="text-xs text-slate-500">
          {role}{company && `, ${company}`}
        </div>
      )}
    </div>
  </figcaption>
</figure>
