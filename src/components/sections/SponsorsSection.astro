---
import type { Sponsor } from '../../content.config';

interface Props {
  sponsors: Sponsor[];
  mailto?: string;
}

const { sponsors, mailto } = Astro.props;
---

<section id="sponsors">
  <h2>Sponsors & Partners</h2>
  <p>Want to become a sponsor? Get in touch!</p>

  {sponsors.length > 0 && (
    <ul>
      {sponsors.map((sponsor) => (
        <li>
          <a href={sponsor.url}>{sponsor.logo}</a>
        </li>
      ))}
    </ul>
  )}

  {mailto && (
    <p><a href={mailto}>Become A Sponsor</a></p>
  )}
</section>
