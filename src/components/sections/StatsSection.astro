---
interface Props {
  event?: any; // Making optional to use globally
  trackCount?: number;
  speakerCount?: number;
  compact?: boolean;
  
  // Global stats override
  globalStats?: {
    cities: number;
    events: number;
    speakers: number;
    attendees: number;
  };
}

const { event, trackCount, speakerCount, globalStats, compact = false } = Astro.props;

const stats = globalStats ? [
  { label: 'Countries', value: globalStats.cities },
  { label: 'Events', value: globalStats.events },
  { label: 'Speakers', value: `50+` },
  { label: 'Attendees', value: `500+` },
] : [
  { label: 'Days', value: event?.days },
  { label: 'Speakers', value: speakerCount },
  { label: 'Tracks', value: trackCount },
  { label: 'Attendees', value: event?.attendees },
];
---

<div class={`bg-white ${compact ? 'py-8 sm:py-10' : 'py-12 sm:py-16'}`}>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <dl class={`grid grid-cols-2 gap-x-8 gap-y-8 text-center lg:grid-cols-4 ${compact ? '' : 'gap-y-16'}`}>
      {stats.map((stat) => (
        <div class="mx-auto flex max-w-xs flex-col gap-y-2">
          <dt class="text-base leading-7 text-slate-600">{stat.label}</dt>
          <dd class={`order-first font-semibold tracking-tight text-slate-900 ${compact ? 'text-2xl sm:text-3xl' : 'text-3xl sm:text-5xl'}`}>
            {stat.value}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</div>
