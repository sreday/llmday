---
import type { Event } from '../../content.config';

interface Props {
  event: Event;
  trackCount: number;
  speakerCount: number;
}

const { event, trackCount, speakerCount } = Astro.props;
---

<section>
  <h2>Stats</h2>
  <ul>
    <li>{event.days} Days</li>
    <li>{speakerCount} Speakers</li>
    <li>{trackCount} Tracks</li>
    <li>{event.attendees} Attendees</li>
  </ul>
</section>
