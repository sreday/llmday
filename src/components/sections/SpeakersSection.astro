---
import type { ScheduleData } from '../../lib/schedule';
import { getSpeakers } from '../../lib/schedule';

interface Props {
  schedule: ScheduleData;
  eventSlug: string;
}

const { schedule, eventSlug } = Astro.props;
const speakers = getSpeakers(schedule);
---

<section id="speakers">
  <h2>Speakers</h2>
  <ul>
    {speakers.map((talk) => {
      const speaker = talk.data.speakers[0];
      return (
        <li>
          <a href={`/${eventSlug}/talks/${talk.slug}/`}>{speaker.name}</a>
          {speaker.organization && ` (${speaker.organization})`}
          - {talk.data.title}
        </li>
      );
    })}
  </ul>
</section>
