---
import type { ScheduleData } from '../../lib/schedule';
import { getSpeakers } from '../../lib/schedule';
import SpeakerCard from '../cards/SpeakerCard.astro';

interface Props {
  schedule: ScheduleData;
  eventSlug: string;
}

const { schedule, eventSlug } = Astro.props;
const speakers = getSpeakers(schedule);
---

<section id="speakers" class="bg-white">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center mb-10">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Speakers</h2>
    </div>
    <div class="mx-auto grid max-w-2xl grid-cols-2 gap-x-8 gap-y-16 lg:mx-0 lg:max-w-none lg:grid-cols-4">
      {speakers.map((talk) => {
        const speaker = talk.data.speakers[0];
        return (
          <SpeakerCard 
            name={speaker.name}
            company={speaker.organization}
            image={speaker.photo} 
            talkTitle={talk.data.title}
            talkSlug={talk.slug}
            eventSlug={eventSlug}
          />
        );
      })}
    </div>
  </div>
</section>
