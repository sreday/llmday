---
import type { ScheduleData } from '../../lib/schedule';
import { getSpeakers } from '../../lib/schedule';
import SpeakerCard from '../cards/SpeakerCard.astro';

interface Props {
  schedule: ScheduleData;
  eventSlug: string;
}

const { schedule, eventSlug } = Astro.props;
const speakers = getSpeakers(schedule);
---

<section id="speakers" class="bg-white">
  <div class="mx-auto max-w-7xl">
    <div class="mb-6">
      <h2 class="text-xl font-bold tracking-tight text-slate-900">Speakers</h2>
    </div>
    <div class="grid grid-cols-3 gap-4 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6">
      {speakers.map((talk) => {
        const speaker = talk.data.speakers[0];
        return (
          <SpeakerCard
            name={speaker.name}
            company={speaker.organization}
            image={speaker.photo}
            talkTitle={talk.data.title}
            talkSlug={talk.slug}
            eventSlug={eventSlug}
          />
        );
      })}
    </div>
  </div>
</section>
