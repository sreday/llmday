---
import type { Event } from '../../content.config';

interface Props {
  event?: Event;
  mode?: 'global' | 'event';
  nextEvent?: {
      id: string;
      data: Event;
  };
  cityName?: string;
}

const { event, mode = 'event', nextEvent, cityName } = Astro.props;
---

{mode === 'global' ? (
  <div class="relative isolate overflow-hidden bg-slate-900">
    {/* Photo background with overlay - cropped to show hands/audience */}
    <div class="absolute inset-0 -z-10">
      <img
        src="/assets/photos/london-2022-0.jpg"
        alt=""
        class="w-full h-full object-cover object-bottom"
        style="object-position: center 85%;"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/80 to-slate-900/40"></div>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8 py-16 sm:py-20">
      <div class="text-center max-w-3xl mx-auto">
        <p class="text-lg sm:text-xl font-semibold tracking-widest text-llm-green uppercase mb-4">
          LLMday
        </p>
        <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl lg:text-4xl leading-tight">
          Large Language Models, AI and ML
        </h1>
        <p class="mt-4 text-xl sm:text-2xl text-slate-200 font-light">
          In-person conferences
        </p>
      </div>
    </div>
  </div>
) : (
  <div class="relative isolate overflow-hidden bg-slate-900 border-b border-white/10">
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-900 to-slate-800"></div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
            LLMday {cityName}
          </h1>
          <p class="mt-1 text-sm text-slate-400">
            {event?.dateString} · {event?.locationString}
          </p>
        </div>

        {event?.state !== 'after' && event?.lumaEventId && (
          <a href="#tickets" class="rounded-full bg-primary-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500">
            Get Tickets
          </a>
        )}
      </div>
    </div>
  </div>
)}
