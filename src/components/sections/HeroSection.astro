---
import type { Event } from '../../content.config';

interface Props {
  event: Event;
}

const { event } = Astro.props;

// Import hero photos
const photoImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png}', { eager: true });

function getHeroImage(filename: string) {
  const path = `/src/assets/photos/${filename}`;
  return photoImages[path]?.default;
}

const heroFilename = event.heroPictures[0] || '';
const heroImage = getHeroImage(heroFilename);
const heroUrl = heroImage?.src || '';
---

<div id="home" class="hero-block">
  <div
    class="hero-background tinted"
    style={`background-image: url('${heroUrl}');`}
  />

  <div class="container">
    <div class="hero-text-block text-center" style="max-width: 100%;">
      <h1 class="logo retro">LLMDAY</h1>
      <h2 class="hero-subtitle">Large Language Models, AI and ML</h2>
      <p class="hero-tagline">In-person conferences</p>
      <h3 class="text-white hero-info">
        <span class="info-item">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          {event.dateString}
        </span>
        <span class="info-item">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {event.locationString}
        </span>
      </h3>

      <div class="hero-cta">
        <a class="btn btn-secondary btn-lg" href="#tickets">Get Tickets</a>
        {event.state !== 'after' && event.cfpUrl && (
          <a class="btn btn-primary btn-lg" href={event.cfpUrl} target="_blank">CFP</a>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .hero-block {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center;
  }

  .hero-background.tinted::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .hero-text-block {
    position: relative;
    z-index: 1;
    padding: 2rem;
  }

  .hero-subtitle {
    color: white;
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .hero-tagline {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .hero-info {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
    align-items: center;
    font-size: 1.25rem;
    font-weight: 400;
    margin-bottom: 1.5rem;
  }

  .info-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon {
    width: 1.25em;
    height: 1.25em;
    vertical-align: middle;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .hero-info {
      flex-direction: column;
      gap: 0.75rem;
    }

    .hero-subtitle {
      font-size: 1.25rem;
    }
  }
</style>
