---
import type { Event } from '../../content.config';
import EventCard from '../cards/EventCard.astro';

interface Props {
  event?: Event; // For event mode
  mode?: 'global' | 'event';
  nextEvent?: {
      id: string;
      data: Event;
  }; // For global mode
}

const { event, mode = 'event', nextEvent } = Astro.props;
---

{mode === 'global' ? (
  <div class="relative isolate overflow-hidden bg-slate-900">
    <!-- Background effects -->
    <div class="absolute inset-0 -z-10 h-full w-full object-cover">
       <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-800"></div>
       <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-20"></div>
    </div>
    
    <div class="mx-auto max-w-7xl px-6 lg:px-8 py-20 sm:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          
          {/* Left: Brand & Messaging */}
          <div class="max-w-2xl text-center lg:text-left">
              <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">
                The Premier Global <br/>
                <span class="text-primary-400">LLM Conference</span>
              </h1>
              <p class="mt-6 text-lg leading-8 text-slate-300">
                Join the world's leading AI engineers, researchers, and founders. Deep dives into Large Language Models, Generative AI, and Machine Learning.
              </p>
              <div class="mt-10 flex items-center justify-center lg:justify-start gap-x-6">
                <a href="#upcoming" class="rounded-full bg-white/10 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-white/20 ring-1 ring-inset ring-white/20">
                    View All Events
                </a>
                <a href="#sponsor" class="text-sm font-semibold leading-6 text-white">Become a Sponsor <span aria-hidden="true">→</span></a>
              </div>
          </div>

          {/* Right: Next Event Highlight (Dashboard Style) */}
          {nextEvent && (
              <div class="relative mx-auto w-full max-w-md lg:ml-auto lg:mr-0">
                  <div class="absolute -inset-2 bg-gradient-to-r from-primary-500 to-primary-700 rounded-2xl opacity-20 blur-lg"></div>
                  <div class="relative bg-slate-800/80 backdrop-blur border border-white/10 rounded-2xl p-6 sm:p-8">
                      <div class="flex items-center justify-between mb-6">
                          <span class="inline-flex items-center rounded-full bg-primary-500/10 px-2 py-1 text-xs font-medium text-primary-400 ring-1 ring-inset ring-primary-500/20">
                            Next Event
                          </span>
                          <span class="text-slate-400 text-sm">{nextEvent.data.dateString}</span>
                      </div>
                      
                      <h2 class="text-2xl font-bold text-white mb-2">
                        LLMday {nextEvent.data.locationString.split(',')[0]}
                      </h2>
                      <p class="text-slate-400 mb-8">
                         {nextEvent.data.locationString}
                      </p>

                      <div class="flex flex-col gap-3">
                          <a href={`/${nextEvent.id}/`} class="w-full rounded-lg bg-primary-600 px-4 py-3 text-center text-sm font-semibold text-white hover:bg-primary-500 transition">
                              View Agenda & Speakers
                          </a>
                          {nextEvent.data.lumaEventId && (
                             <a href={`https://lu.ma/event/${nextEvent.data.lumaEventId}`} target="_blank" class="w-full rounded-lg bg-white/5 px-4 py-3 text-center text-sm font-semibold text-white hover:bg-white/10 ring-1 ring-inset ring-white/10 transition">
                                Register Now
                             </a>
                          )}
                      </div>
                  </div>
              </div>
          )}

      </div>
    </div>
  </div>
) : (
  <div class="relative isolate overflow-hidden bg-slate-900 border-b border-white/10">
     <div class="absolute inset-0 -z-10 h-full w-full object-cover">
         <div class="absolute inset-0 bg-gradient-to-r from-slate-900 to-slate-800"></div>
     </div>
     <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
           <div>
               <div class="inline-flex items-center rounded-md bg-primary-500/10 px-2 py-1 text-xs font-medium text-primary-400 ring-1 ring-inset ring-primary-500/20 mb-3">
                  {event?.dateString}
               </div>
               <h1 class="text-3xl font-bold tracking-tight text-white sm:text-5xl">
                  LLMday {event?.locationString.split(',')[0]}
               </h1>
               <p class="mt-2 text-lg text-slate-400 max-w-xl">
                  {event?.locationString}
               </p>
           </div>
           
           <div class="flex gap-4">
               {event?.state !== 'after' && event?.lumaEventId && (
                  <a href="#tickets" class="rounded-full bg-primary-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-400">
                    Get Tickets
                  </a>
                )}
           </div>
        </div>
     </div>
  </div>
)}
