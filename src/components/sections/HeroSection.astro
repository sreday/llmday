---
import type { Event } from '../../content.config';

interface Props {
  event: Event;
}

const { event } = Astro.props;
---

<section id="home">
  <h1>LLMDAY</h1>
  <p>Large Language Models, AI and ML</p>
  <p>In-person conferences</p>
  <p><strong>Date:</strong> {event.dateString}</p>
  <p><strong>Location:</strong> {event.locationString}</p>
  <p>
    <a href="#tickets">Get Tickets</a>
    {event.state !== 'after' && event.cfpUrl && (
      <> | <a href={event.cfpUrl}>Call for Papers</a></>
    )}
  </p>
</section>
