---
import type { Venue } from '../../content.config';

interface Props {
  venue: Venue;
}

const { venue } = Astro.props;
---

<section id="venue">
  <h2>Venue</h2>
  <h3>{venue.name}</h3>
  <address>
    {venue.address}, {venue.city}
  </address>
  <iframe
    src={venue.mapEmbedUrl}
    width="600"
    height="300"
    frameborder="1"
    loading="lazy"
  />
</section>
