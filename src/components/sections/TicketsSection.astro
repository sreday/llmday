---
interface Props {
  lumaEventId: string;
}

const { lumaEventId } = Astro.props;
---

<section id="tickets">
  <h2>Tickets</h2>
  <p><a href={`https://lu.ma/event/${lumaEventId}`}>Register on Luma</a></p>
  <iframe
    src={`https://lu.ma/embed/event/${lumaEventId}/simple`}
    width="600"
    height="400"
    frameborder="1"
  />
</section>
