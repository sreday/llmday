---
import { getCollection } from 'astro:content';
import { format, parseISO } from 'date-fns';
import BaseLayout from '../components/layout/BaseLayout.astro';
import EventCard from '../components/cards/EventCard.astro';
import TestimonialCard from '../components/cards/TestimonialCard.astro';

const events = await getCollection('events');
const testimonials = await getCollection('testimonials');

// Format date from startTime
function formatEventDate(startTime: string): string {
  const date = parseISO(startTime);
  return format(date, 'MMMM d, yyyy');
}

// Format event name from ID (e.g., "2026-warsaw-q1" -> "Warsaw 2026 Q1")
function formatEventName(eventId: string): string {
  const parts = eventId.split('-'); // ["2026", "warsaw", "q1"] or ["2026", "nyc", "q1"]
  const year = parts[0];
  const city = parts[1].toUpperCase() === 'NYC' ? 'NYC' : parts[1].charAt(0).toUpperCase() + parts[1].slice(1);
  const quarter = parts[2]?.toUpperCase() || '';
  return `LLMday ${city} ${year} ${quarter}`.trim();
}

// Import hero photos
const photoImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png}', { eager: true });

function getPhoto(filename: string) {
  const path = `/src/assets/photos/${filename}`;
  return photoImages[path]?.default;
}

const defaultHeroPhoto = getPhoto('london-2022-0.jpg');

// Import event city skyline images
const eventImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/events/*.png', { eager: true });

function getEventImage(eventId: string) {
  const path = `/src/assets/events/llmday-${eventId}.png`;
  return eventImages[path]?.default;
}

// Sort events by date
const sortedEvents = events.sort((a, b) => {
  return new Date(a.data.startTime).getTime() - new Date(b.data.startTime).getTime();
});

const upcomingEvents = sortedEvents.filter((e) => e.data.state !== 'after');
const pastEvents = sortedEvents.filter((e) => e.data.state === 'after');
---

<BaseLayout title="LLMday - Large Language Models Conferences">
  <!-- Hero -->
  <div class="hero-block" style="min-height: 60vh;">
    <div class="tinted" style={`position: absolute; inset: 0; background: url('${defaultHeroPhoto?.src || ''}') center/cover;`}></div>
    <div class="container" style="position: relative; z-index: 10;">
      <div class="hero-text-block text-center">
        <h1 class="logo retro">LLMDAY</h1>
        <h2 class="text-white">Large Language Models, AI and ML In-person Conferences</h2>
        <p class="text-white mt-3">Worldwide - Europe and US</p>
        <div class="hero-social mt-4">
          <a href="https://www.linkedin.com/company/llmday/" target="_blank" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.youtube.com/@llmday_com" target="_blank" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="https://twitter.com/llmday_com" target="_blank" aria-label="Twitter">
            <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
          </a>
        </div>
        <div class="hero-divider"></div>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="stats-block theme-bg-primary text-white py-4 text-center">
    <div class="container">
      <div class="stats-row">
        <div class="stat-item">
          <div class="number">3</div>
          <div class="unit">Countries</div>
        </div>
        <div class="stat-item">
          <div class="number">{events.length}</div>
          <div class="unit">Events</div>
        </div>
        <div class="stat-item">
          <div class="number">50+</div>
          <div class="unit">Speakers</div>
        </div>
        <div class="stat-item">
          <div class="number">500+</div>
          <div class="unit">Attendees</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Upcoming Events -->
  {upcomingEvents.length > 0 && (
    <section id="upcoming" class="section">
      <div class="container">
        <h3 class="section-heading text-center mb-5">Upcoming Conferences</h3>
        <div class="row g-4">
          {upcomingEvents.map((event) => (
            <div class="col-12 col-md-6 col-lg-4">
              <EventCard
                name={formatEventName(event.id)}
                location={event.data.locationString}
                date={formatEventDate(event.data.startTime)}
                photo={getEventImage(event.id) || getPhoto(event.data.heroPictures[0]) || defaultHeroPhoto}
                url={`/${event.id}/`}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Past Events -->
  {pastEvents.length > 0 && (
    <section id="past" class="section bg-light">
      <div class="container">
        <h3 class="section-heading text-center mb-5">Past Conferences</h3>
        <div class="row g-4">
          {pastEvents.map((event) => (
            <div class="col-12 col-md-6 col-lg-4">
              <EventCard
                name={formatEventName(event.id)}
                location={event.data.locationString}
                date={formatEventDate(event.data.startTime)}
                photo={getEventImage(event.id) || getPhoto(event.data.heroPictures[0]) || defaultHeroPhoto}
                url={`/${event.id}/`}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Testimonials -->
  {testimonials.length > 0 && (
    <section id="testimonials" class="section">
      <div class="container">
        <h3 class="section-heading text-center mb-5">What others say about LLMday</h3>
        <div class="row g-4">
          {testimonials.map((entry) => (
            <div class="col-12 col-md-6">
              <TestimonialCard testimonial={entry.data} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Sponsor CTA -->
  <section id="sponsor" class="section theme-bg-primary text-white">
    <div class="container text-center">
      <h3 class="section-heading text-white mb-5">Sponsor</h3>
      <!-- Calendly inline widget -->
      <div class="calendly-inline-widget" data-url="https://calendly.com/mark-llmday/30-sponsor" style="min-width:320px;height:700px;"></div>
      <script is:inline type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
    </div>
  </section>

  <!-- Partner CTA -->
  <section id="partner" class="section bg-light">
    <div class="container text-center">
      <h3 class="section-heading mb-3">Partner</h3>
      <p class="text-muted mb-4">Interested in bringing LLMday to your city?</p>
      <a href="mailto:hello@llmday.com" class="btn btn-secondary btn-lg">Become A Partner</a>
    </div>
  </section>
</BaseLayout>
