---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/layout/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import StatsSection from '../components/sections/StatsSection.astro';
import EventCard from '../components/cards/EventCard.astro';
import TestimonialCard from '../components/cards/TestimonialCard.astro';
import SponsorsSection from '../components/sections/SponsorsSection.astro';

const events = await getCollection('events');
const testimonials = await getCollection('testimonials');

const sortedEvents = events.sort((a, b) => {
  return new Date(a.data.startTime).getTime() - new Date(b.data.startTime).getTime();
});

const upcomingEvents = sortedEvents.filter((e) => e.data.state !== 'after');
const pastEvents = sortedEvents.filter((e) => e.data.state === 'after').reverse(); // Newest past first

const globalStats = {
  cities: new Set(events.map(e => e.data.locationString.split(',')[0].trim())).size,
  events: events.length,
  speakers: 50, // Static for now, could be dynamic
  attendees: 500
};

// Dummy sponsors for home page
const globalSponsors = [
  { logo: 'viam', url: 'https://www.viam.com/' },
  { logo: 'quesma', url: 'https://quesma.com/' },
  { logo: 'monday', url: 'https://monday.com/' },
  { logo: 'hockeystick', url: 'https://www.hockeystick.show' }
];
---

<BaseLayout title="LLMday - The Premier Global LLM Conference Series">
  
  <HeroSection mode="global" />
  
  {/* Lifted section: Negative margin to pull it up over the hero bottom or just closer */}
  <div class="relative z-10 -mt-12 sm:-mt-16 mx-auto max-w-7xl px-6 lg:px-8">
      <div class="rounded-2xl bg-white shadow-xl ring-1 ring-slate-900/5">
        <StatsSection globalStats={globalStats} />
      </div>
  </div>

  <section id="upcoming" class="pt-16 pb-24 sm:pt-24 sm:pb-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Upcoming Conferences</h2>
        <p class="mt-2 text-lg leading-8 text-slate-600">
          Join us in a city near you.
        </p>
      </div>
      
      {upcomingEvents.length > 0 ? (
        <div class="mx-auto mt-12 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-12 lg:mx-0 lg:max-w-none lg:grid-cols-3">
          {upcomingEvents.map((event) => (
            <EventCard 
              id={event.id}
              locationString={event.data.locationString}
              startTime={event.data.startTime}
              state={event.data.state}
            />
          ))}
        </div>
      ) : (
        <div class="mt-16 text-center text-slate-500">
          No upcoming events scheduled at the moment. Check back soon!
        </div>
      )}
    </div>
  </section>

  {testimonials.length > 0 && (
    <section id="testimonials" class="bg-slate-50 py-24 sm:py-32">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Community Feedback</h2>
        </div>
        <div class="mx-auto mt-16 flow-root max-w-2xl sm:mt-20 lg:mx-0 lg:max-w-none">
          <div class="-mt-8 sm:-mx-4 sm:columns-2 sm:text-[0] lg:columns-3">
            {testimonials.map((entry) => (
              <div class="pt-8 sm:inline-block sm:w-full sm:px-4">
                <TestimonialCard
                  name={entry.data.name}
                  role={entry.data.job}
                  company={entry.data.company}
                  quote={entry.data.text}
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {pastEvents.length > 0 && (
    <section id="past" class="bg-white py-24 sm:py-32">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Past Events</h2>
          <p class="mt-2 text-lg leading-8 text-slate-600">
             See what you missed.
          </p>
        </div>
        <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-8 lg:mx-0 lg:max-w-none lg:grid-cols-4">
           {pastEvents.map((event) => (
            <EventCard 
              id={event.id}
              locationString={event.data.locationString}
              startTime={event.data.startTime}
              state={event.data.state}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <SponsorsSection sponsors={globalSponsors} mailto="mailto:hello@llmday.com" />

</BaseLayout>
