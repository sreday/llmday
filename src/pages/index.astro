---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/layout/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import TestimonialCard from '../components/cards/TestimonialCard.astro';
import SponsorsSection from '../components/sections/SponsorsSection.astro';
import { format, parseISO } from 'date-fns';

const events = await getCollection('events');
const testimonials = await getCollection('testimonials');

const sortedEvents = events.sort((a, b) => {
  return new Date(a.data.startTime).getTime() - new Date(b.data.startTime).getTime();
});

const upcomingEvents = sortedEvents.filter((e) => e.data.state !== 'after');
const pastEvents = sortedEvents.filter((e) => e.data.state === 'after').reverse();

const globalSponsors = [
  { logo: 'viam', url: 'https://www.viam.com/' },
  { logo: 'quesma', url: 'https://quesma.com/' },
  { logo: 'monday', url: 'https://monday.com/' },
  { logo: 'hockeystick', url: 'https://www.hockeystick.show' }
];

// Helper to get city from event ID (e.g., "2026-warsaw-q1" -> "Warsaw")
function getCityFromId(eventId: string) {
  const cityMap: Record<string, string> = {
    'warsaw': 'Warsaw',
    'nyc': 'New York',
    'london': 'London',
    'berlin': 'Berlin',
    'paris': 'Paris',
    'sf': 'San Francisco',
  };
  const parts = eventId.split('-');
  const cityKey = parts[1]; // e.g., "warsaw", "nyc", "london"
  return cityMap[cityKey] || cityKey.charAt(0).toUpperCase() + cityKey.slice(1);
}
---

<BaseLayout title="LLMday - The Premier Global LLM Conference Series">

  <HeroSection mode="global" />

  {/* Upcoming Events - Directly visible, no scrolling needed */}
  <section id="upcoming" class="py-8 sm:py-10 bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2 class="text-lg font-bold text-slate-900 mb-4">Upcoming Events</h2>

      {upcomingEvents.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {upcomingEvents.map((event) => {
            const date = parseISO(event.data.startTime);
            const city = getCityFromId(event.id);
            return (
              <a href={`/${event.id}/`} class="group block rounded-lg border border-slate-200 p-4 hover:border-primary-500 hover:shadow-sm transition-all">
                <div class="flex items-start justify-between gap-4">
                  <div class="min-w-0">
                    <h3 class="font-semibold text-slate-900 group-hover:text-primary-600">
                      LLMday {city}
                    </h3>
                    <p class="text-sm text-slate-500 mt-1">{event.data.locationString}</p>
                  </div>
                  <div class="text-right shrink-0">
                    <div class="text-xs font-medium text-slate-500 uppercase">{format(date, 'MMM')}</div>
                    <div class="text-xl font-bold text-slate-900">{format(date, 'd')}</div>
                  </div>
                </div>
                <div class="mt-3 flex items-center justify-between">
                  <span class="inline-flex items-center rounded bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">
                    Open for Registration
                  </span>
                  <span class="text-xs font-medium text-primary-600">View Details →</span>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="text-sm text-slate-500">No upcoming events scheduled.</p>
      )}
    </div>
  </section>

  {/* Testimonials - Compact */}
  {testimonials.length > 0 && (
    <section id="testimonials" class="py-8 sm:py-10 bg-slate-50">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <h2 class="text-lg font-bold text-slate-900 mb-4">Community Feedback</h2>
        <div class={`grid gap-4 ${testimonials.length === 1 ? 'max-w-lg' : 'sm:grid-cols-2 lg:grid-cols-3'}`}>
          {testimonials.map((entry) => (
            <TestimonialCard
              name={entry.data.name}
              role={entry.data.job}
              company={entry.data.company}
              quote={entry.data.text}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Past Events - Compact list */}
  {pastEvents.length > 0 && (
    <section id="past" class="py-8 sm:py-10 bg-white">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <h2 class="text-lg font-bold text-slate-900 mb-4">Past Events</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {pastEvents.map((event) => {
            const date = parseISO(event.data.startTime);
            const city = getCityFromId(event.id);
            return (
              <a href={`/${event.id}/`} class="group flex items-center gap-3 rounded-lg border border-slate-200 p-3 hover:border-slate-300 transition-all">
                <div class="text-center shrink-0 w-10">
                  <div class="text-[10px] font-medium text-slate-400 uppercase">{format(date, 'MMM')}</div>
                  <div class="text-sm font-bold text-slate-600">{format(date, 'yy')}</div>
                </div>
                <div class="min-w-0">
                  <h3 class="text-sm font-medium text-slate-700 group-hover:text-slate-900 truncate">
                    LLMday {city}
                  </h3>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* Sponsors - Compact */}
  <section id="sponsors" class="py-8 sm:py-10 bg-slate-50 border-t border-slate-200">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-slate-900">Sponsors</h2>
          <p class="text-sm text-slate-500">Partners who make LLMday possible</p>
        </div>
        <div class="flex items-center gap-6">
          {globalSponsors.map((sponsor) => {
            const logoFile = sponsor.logo.includes('.') ? sponsor.logo : `${sponsor.logo}.png`;
            return (
              <a href={sponsor.url} target="_blank" rel="noopener noreferrer" class="group">
                <img
                  src={`/assets/sponsors/${logoFile}`}
                  alt={sponsor.logo}
                  class="h-6 sm:h-8 w-auto object-contain opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition"
                  loading="lazy"
                />
              </a>
            );
          })}
        </div>
      </div>
      <div class="mt-4 text-center sm:text-right">
        <a href="mailto:hello@llmday.com" class="text-sm font-medium text-primary-600 hover:text-primary-700">
          Become a sponsor →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
