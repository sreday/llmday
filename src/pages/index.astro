---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/layout/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import StatsSection from '../components/sections/StatsSection.astro';
import TestimonialCard from '../components/cards/TestimonialCard.astro';
import SponsorsSection from '../components/sections/SponsorsSection.astro';
import EventCard from '../components/cards/EventCard.astro';

const events = await getCollection('events');
const testimonials = await getCollection('testimonials');

const sortedEvents = events.sort((a, b) => {
  return new Date(a.data.startTime).getTime() - new Date(b.data.startTime).getTime();
});

const upcomingEvents = sortedEvents.filter((e) => e.data.state !== 'after');
const pastEvents = sortedEvents.filter((e) => e.data.state === 'after').reverse(); // Newest past first
const nextEvent = upcomingEvents.length > 0 ? upcomingEvents[0] : undefined;
const otherUpcomingEvents = upcomingEvents.length > 1 ? upcomingEvents.slice(1) : [];

const globalStats = {
  cities: new Set(events.map(e => e.data.locationString.split(',')[0].trim())).size,
  events: events.length,
  speakers: 50, // Static for now, could be dynamic
  attendees: 500
};

// Dummy sponsors for home page
const globalSponsors = [
  { logo: 'viam', url: 'https://www.viam.com/' },
  { logo: 'quesma', url: 'https://quesma.com/' },
  { logo: 'monday', url: 'https://monday.com/' },
  { logo: 'hockeystick', url: 'https://www.hockeystick.show' }
];
---

<BaseLayout title="LLMday - The Premier Global LLM Conference Series">
  
  <HeroSection mode="global" nextEvent={nextEvent} />
  
  {/* Stats Strip - Compact */}
  <div class="border-b border-slate-200 bg-white">
      <StatsSection globalStats={globalStats} compact={true} />
  </div>

  <section id="upcoming" class="py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center mb-10">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">Upcoming Events</h2>
      </div>
      
      {otherUpcomingEvents.length > 0 ? (
         <div class="mx-auto grid max-w-2xl grid-cols-1 gap-8 lg:mx-0 lg:max-w-none lg:grid-cols-3">
             {/* If we have other upcoming events, show them here */}
             {otherUpcomingEvents.map(event => (
                 <EventCard 
                   id={event.id}
                   locationString={event.data.locationString}
                   startTime={event.data.startTime}
                   state={event.data.state}
                 />
             ))}
         </div>
      ) : (
          upcomingEvents.length === 1 ? (
             <p class="text-center text-slate-500">More events coming soon.</p>
          ) : (
             <p class="text-center text-slate-500">No upcoming events scheduled at the moment.</p>
          )
      )}
    </div>
  </section>

  {testimonials.length > 0 && (
    <section id="testimonials" class="bg-slate-50 py-10 sm:py-12">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mb-6">
          <h2 class="text-xl font-bold tracking-tight text-slate-900 text-center">Community Feedback</h2>
        </div>
        <div class={`grid gap-4 ${testimonials.length === 1 ? 'max-w-xl mx-auto' : 'sm:grid-cols-2 lg:grid-cols-3'}`}>
          {testimonials.map((entry) => (
            <TestimonialCard
              name={entry.data.name}
              role={entry.data.job}
              company={entry.data.company}
              quote={entry.data.text}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {pastEvents.length > 0 && (
    <section id="past" class="bg-white py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-10">
          <h2 class="text-3xl font-bold tracking-tight text-slate-900">Past Events</h2>
        </div>
        <div class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-8 lg:mx-0 lg:max-w-none lg:grid-cols-4">
           {pastEvents.map((event) => (
            <EventCard 
              id={event.id}
              locationString={event.data.locationString}
              startTime={event.data.startTime}
              state={event.data.state}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <SponsorsSection sponsors={globalSponsors} mailto="mailto:hello@llmday.com" />

</BaseLayout>
