---
import { getCollection } from 'astro:content';
import { format, parseISO } from 'date-fns';
import BaseLayout from '../components/layout/BaseLayout.astro';

const events = await getCollection('events');
const testimonials = await getCollection('testimonials');

function formatEventDate(startTime: string): string {
  const date = parseISO(startTime);
  return format(date, 'MMMM d, yyyy');
}

function formatEventName(eventId: string): string {
  const parts = eventId.split('-');
  const year = parts[0];
  const city = parts[1].toUpperCase() === 'NYC' ? 'NYC' : parts[1].charAt(0).toUpperCase() + parts[1].slice(1);
  const quarter = parts[2]?.toUpperCase() || '';
  return `LLMday ${city} ${year} ${quarter}`.trim();
}

const sortedEvents = events.sort((a, b) => {
  return new Date(a.data.startTime).getTime() - new Date(b.data.startTime).getTime();
});

const upcomingEvents = sortedEvents.filter((e) => e.data.state !== 'after');
const pastEvents = sortedEvents.filter((e) => e.data.state === 'after');
---

<BaseLayout title="LLMday - Large Language Models Conferences">
  <h1>LLMDAY</h1>
  <p>Large Language Models, AI and ML In-person Conferences</p>
  <p>Worldwide - Europe and US</p>

  <h2>Stats</h2>
  <ul>
    <li>3 Countries</li>
    <li>{events.length} Events</li>
    <li>50+ Speakers</li>
    <li>500+ Attendees</li>
  </ul>

  {upcomingEvents.length > 0 && (
    <section id="upcoming">
      <h2>Upcoming conferences</h2>
      <ul>
        {upcomingEvents.map((event) => (
          <li>
            <a href={`/${event.id}/`}>{formatEventName(event.id)}</a>
            - {formatEventDate(event.data.startTime)}
            ({event.data.locationString})
          </li>
        ))}
      </ul>
      <h3>Upcoming meetups</h3>
      <p>(none scheduled)</p>
    </section>
  )}

  <section>
    <h2>Past conferences</h2>
    <h3>Past meetups</h3>
  </section>

  {pastEvents.length > 0 && (
    <section id="past">
      <ul>
        {pastEvents.map((event) => (
          <li>
            <a href={`/${event.id}/`}>{formatEventName(event.id)}</a>
            - {formatEventDate(event.data.startTime)}
          </li>
        ))}
      </ul>
    </section>
  )}

  {testimonials.length > 0 && (
    <section id="testimonials">
      <h2>What others say about LLMday</h2>
      {testimonials.map((entry) => (
        <blockquote>
          <p>{entry.data.text}</p>
          <p>— {entry.data.name}
            {entry.data.job && `, ${entry.data.job}`}
            {entry.data.company && ` at ${entry.data.company}`}
          </p>
        </blockquote>
      ))}
    </section>
  )}

  <section id="sponsor">
    <h2>Sponsor</h2>
    <p>Interested in sponsoring LLMday?</p>
    <p><a href="https://calendly.com/mark-llmday/30-sponsor">Schedule a call</a></p>
  </section>

  <section id="partner">
    <h2>Partner</h2>
    <p>Interested in bringing LLMday to your city?</p>
    <p><a href="mailto:hello@llmday.com">Become A Partner</a></p>
  </section>
</BaseLayout>
