---
import { getCollection } from 'astro:content';
import { format, parseISO } from 'date-fns';
import BaseLayout from '../components/layout/BaseLayout.astro';
import EventCard from '../components/cards/EventCard.astro';
import TestimonialCard from '../components/cards/TestimonialCard.astro';

const events = await getCollection('events');
const testimonials = await getCollection('testimonials');

// Format date from startTime
function formatEventDate(startTime: string): string {
  const date = parseISO(startTime);
  return format(date, 'MMMM d, yyyy');
}

// Format event name from ID (e.g., "2026-warsaw-q1" -> "Warsaw 2026 Q1")
function formatEventName(eventId: string): string {
  const parts = eventId.split('-'); // ["2026", "warsaw", "q1"] or ["2026", "nyc", "q1"]
  const year = parts[0];
  const city = parts[1].toUpperCase() === 'NYC' ? 'NYC' : parts[1].charAt(0).toUpperCase() + parts[1].slice(1);
  const quarter = parts[2]?.toUpperCase() || '';
  return `LLMday ${city} ${year} ${quarter}`.trim();
}

// Import hero photos
const photoImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png}', { eager: true });

function getPhoto(filename: string) {
  const path = `/src/assets/photos/${filename}`;
  return photoImages[path]?.default;
}

const defaultHeroPhoto = getPhoto('london-2022-0.jpg');

// Sort events by date
const sortedEvents = events.sort((a, b) => {
  return new Date(a.data.startTime).getTime() - new Date(b.data.startTime).getTime();
});

const upcomingEvents = sortedEvents.filter((e) => e.data.state !== 'after');
const pastEvents = sortedEvents.filter((e) => e.data.state === 'after');
---

<BaseLayout title="LLMday - Large Language Models Conferences">
  <!-- Hero -->
  <div class="hero-block" style="min-height: 60vh;">
    <div class="tinted" style={`position: absolute; inset: 0; background: url('${defaultHeroPhoto?.src || ''}') center/cover;`}></div>
    <div class="container" style="position: relative; z-index: 10;">
      <div class="hero-text-block text-center">
        <h1 class="logo retro">LLMDAY</h1>
        <h2 class="text-white">Large Language Models, AI and ML Conferences</h2>
        <p class="text-white mt-3">Join us at one of our upcoming events around the world</p>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="stats-block theme-bg-primary text-white py-4 text-center">
    <div class="container">
      <div class="stats-row">
        <div class="stat-item">
          <div class="number">{events.length}</div>
          <div class="unit">Events</div>
        </div>
        <div class="stat-item">
          <div class="number">3</div>
          <div class="unit">Countries</div>
        </div>
        <div class="stat-item">
          <div class="number">50+</div>
          <div class="unit">Speakers</div>
        </div>
        <div class="stat-item">
          <div class="number">500+</div>
          <div class="unit">Attendees</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Upcoming Events -->
  {upcomingEvents.length > 0 && (
    <section class="section">
      <div class="container">
        <h3 class="section-heading text-center mb-5">Upcoming Conferences</h3>
        <div class="row g-4">
          {upcomingEvents.map((event) => (
            <div class="col-12 col-md-6 col-lg-4">
              <EventCard
                name={formatEventName(event.id)}
                location={event.data.locationString}
                date={formatEventDate(event.data.startTime)}
                photo={getPhoto(event.data.heroPictures[0]) || defaultHeroPhoto}
                url={`/${event.id}/`}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Past Events -->
  {pastEvents.length > 0 && (
    <section class="section bg-light">
      <div class="container">
        <h3 class="section-heading text-center mb-5">Past Conferences</h3>
        <div class="row g-4">
          {pastEvents.map((event) => (
            <div class="col-12 col-md-6 col-lg-4">
              <EventCard
                name={formatEventName(event.id)}
                location={event.data.locationString}
                date={formatEventDate(event.data.startTime)}
                photo={getPhoto(event.data.heroPictures[0]) || defaultHeroPhoto}
                url={`/${event.id}/`}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Testimonials -->
  {testimonials.length > 0 && (
    <section class="section">
      <div class="container">
        <h3 class="section-heading text-center mb-5">What others say about LLMday</h3>
        <div class="row g-4">
          {testimonials.map((entry) => (
            <div class="col-12 col-md-6">
              <TestimonialCard testimonial={entry.data} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Partner CTA -->
  <section class="section bg-light">
    <div class="container text-center">
      <h3 class="section-heading mb-3">Partner</h3>
      <p class="text-muted mb-4">Interested in bringing LLMday to your city?</p>
      <a href="mailto:hello@llmday.com" class="btn btn-primary btn-lg">Become A Partner</a>
    </div>
  </section>
</BaseLayout>
