---
import { getCollection } from 'astro:content';
import { buildSchedule } from '../../lib/schedule';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import ScheduleSection from '../../components/schedule/ScheduleSection.astro';
import SpeakersSection from '../../components/sections/SpeakersSection.astro';
import VenueSection from '../../components/sections/VenueSection.astro';
import SponsorsSection from '../../components/sections/SponsorsSection.astro';
import TicketsSection from '../../components/sections/TicketsSection.astro';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { event: event.id },
    props: { event: event.data, eventId: event.id },
  }));
}

const { event, eventId } = Astro.props;
const allTalks = await getCollection('talks');
const schedule = buildSchedule({ ...event, id: eventId }, allTalks);

// Get city name from event ID
const cityMap: Record<string, string> = {
  'warsaw': 'Warsaw',
  'nyc': 'New York',
  'london': 'London',
  'berlin': 'Berlin',
  'paris': 'Paris',
  'sf': 'San Francisco',
};
const cityKey = eventId.split('-')[1];
const cityName = cityMap[cityKey] || cityKey.charAt(0).toUpperCase() + cityKey.slice(1);
---

<BaseLayout title={`LLMday ${cityName}`} event={event}>

  <HeroSection event={event} mode="event" cityName={cityName} />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <div class="lg:grid lg:grid-cols-3 gap-8 lg:gap-12">

      {/* Left Main Column (Schedule & Content) */}
      <div class="lg:col-span-2 space-y-12">

        {/* Schedule */}
        <div id="schedule" class="scroll-mt-20">
          <div class="flex items-baseline justify-between border-b border-slate-200 pb-3 mb-4">
            <h2 class="text-xl font-bold leading-7 text-slate-900">
              Schedule
            </h2>
             <p class="text-xs text-slate-500">
                {schedule.tracks.length > 1 ? `${schedule.tracks.length} Tracks` : ''}
             </p>
          </div>

          {event.state === 'before' && !schedule.allTimes.length ? (
            <div class="rounded-lg bg-slate-50 p-6 text-center">
              <p class="text-slate-500 text-sm">Schedule coming soon.</p>
            </div>
          ) : (
             <ScheduleSection schedule={schedule} eventSlug={eventId} />
          )}
        </div>

        {/* Speakers */}
        <div id="speakers" class="scroll-mt-20">
           <SpeakersSection schedule={schedule} eventSlug={eventId} />
        </div>

      </div>

      {/* Right Sidebar (Sticky Logistics) - Hidden on mobile, shown via sticky bar */}
      <div class="hidden lg:block lg:col-span-1">
        <div class="lg:sticky lg:top-24 space-y-6">
            {event.state !== 'after' && event.lumaEventId && (
                <div id="tickets" class="scroll-mt-24">
                  <TicketsSection lumaEventId={event.lumaEventId} />
                </div>
            )}

            <div id="venue" class="scroll-mt-24">
                <VenueSection venue={event.venue} />
            </div>

            <div id="sponsors" class="rounded-2xl bg-white p-5 ring-1 ring-slate-900/5 shadow-sm">
                <h2 class="text-sm font-semibold text-slate-900 mb-3">Sponsors</h2>
                <SponsorsSection sponsors={event.sponsors} mailto={event.mailto} showTitle={false} />
            </div>
        </div>
      </div>

    </div>
  </div>

  {/* Mobile Sticky Action Bar */}
  {event.state !== 'after' && event.lumaEventId && (
    <div class="fixed bottom-0 left-0 right-0 z-50 border-t border-slate-200 bg-white p-4 lg:hidden shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)]">
        <div class="flex gap-4">
            <a href="#tickets" class="flex-1 rounded-full bg-primary-600 px-4 py-3 text-center text-sm font-semibold text-white shadow-sm hover:bg-primary-500">
                Get Tickets
            </a>
            <a href="#schedule" class="flex-1 rounded-full bg-slate-100 px-4 py-3 text-center text-sm font-semibold text-slate-900 hover:bg-slate-200">
                View Schedule
            </a>
        </div>
    </div>
  )}

</BaseLayout>
