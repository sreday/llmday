---
import { getCollection } from 'astro:content';
import { buildSchedule } from '../../lib/schedule';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import ScheduleSection from '../../components/schedule/ScheduleSection.astro';
import SpeakersSection from '../../components/sections/SpeakersSection.astro';
import VenueSection from '../../components/sections/VenueSection.astro';
import SponsorsSection from '../../components/sections/SponsorsSection.astro';
import TicketsSection from '../../components/sections/TicketsSection.astro';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { event: event.id },
    props: { event: event.data, eventId: event.id },
  }));
}

const { event, eventId } = Astro.props;
const allTalks = await getCollection('talks');
const schedule = buildSchedule({ ...event, id: eventId }, allTalks);
---

<BaseLayout title={`LLMday ${event.locationString.split(',')[0]}`} event={event}>
  
  <HeroSection event={event} mode="event" />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
      
      {/* Left Main Column */}
      <div class="lg:col-span-2 space-y-16">
        
        {/* Schedule */}
        <div id="schedule">
          <div class="border-b border-slate-200 pb-5 mb-8">
            <h2 class="text-2xl font-bold leading-7 text-slate-900 sm:truncate sm:text-3xl sm:tracking-tight">
              Schedule
            </h2>
             <p class="mt-2 text-sm text-slate-500">
                {schedule.tracks.length > 1 ? `${schedule.tracks.length} Tracks` : 'Single Track'} • {event.dateString}
             </p>
          </div>
          
          {event.state === 'before' && !schedule.allTimes.length ? (
            <div class="rounded-lg bg-slate-50 p-8 text-center">
              <p class="text-slate-500">Schedule coming soon.</p>
            </div>
          ) : (
             <ScheduleSection schedule={schedule} eventSlug={eventId} />
          )}
        </div>

        {/* Speakers */}
        <div id="speakers">
           <SpeakersSection schedule={schedule} eventSlug={eventId} />
        </div>
        
      </div>

      {/* Right Sidebar */}
      <div class="lg:col-span-1 space-y-8">
        
        {/* Sticky Wrapper */}
        <div class="sticky top-24 space-y-8">
            {event.state !== 'after' && event.lumaEventId && (
                <TicketsSection lumaEventId={event.lumaEventId} />
            )}
            
            <VenueSection venue={event.venue} />
            
            <div class="rounded-2xl bg-white p-6 ring-1 ring-slate-900/5 shadow-sm">
                <h2 class="text-sm font-semibold text-slate-900 mb-4">Sponsors</h2>
                <SponsorsSection sponsors={event.sponsors} mailto={event.mailto} showTitle={false} />
            </div>
        </div>

      </div>

    </div>
  </div>

</BaseLayout>
